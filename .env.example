# Modèle de configuration SmartInvoice — copier en `.env` et compléter.
#
#   cp .env.example .env
#
# Ce fichier est lu à la fois par l'application (pydantic-settings) et par
# Docker Compose (interpolation des variables du docker-compose.yml).
# La suite de tests, elle, ignore complètement ce fichier (tests/conftest.py).

# --- Base de données ---------------------------------------------------------
# En local (hors Docker) : pointer vers l'instance PostgreSQL de développement.
# Sous Docker Compose, DATABASE_URL est construite automatiquement à partir des
# trois variables POSTGRES_* ci-dessous ; nul besoin de la renseigner ici.
DATABASE_URL=postgresql+psycopg2://smartinvoice:smartinvoice@localhost:5432/smartinvoice
POSTGRES_USER=smartinvoice
POSTGRES_PASSWORD=smartinvoice
POSTGRES_DB=smartinvoice

# --- Application -------------------------------------------------------------
ENVIRONMENT=development
# OBLIGATOIRE en production : l'API refuse de démarrer avec la clé par défaut.
# Générer une valeur : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me-0123456789abcdef
LOG_LEVEL=INFO
STORAGE_ROOT=storage
# Origines autorisées à appeler l'API depuis le navigateur (séparées par ,).
CORS_ORIGINS=http://localhost:3000
# Durées de vie des jetons.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Rotation du secret JWT : anciennes clés (séparées par ,) encore acceptées à
# la vérification, le temps que les jetons déjà émis expirent.
JWT_LEGACY_SECRETS=
# Taille maximale d'un document déposé.
MAX_UPLOAD_SIZE_MB=20

# --- Limitation de débit -----------------------------------------------------
# Compteur en mémoire du processus : cohérent avec l'unique worker uvicorn.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Ports publiés par Docker Compose ---------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- OCR ---------------------------------------------------------------------
OCR_ENGINE=paddle
OCR_LANG=fr
# Langue Tesseract (ISO 639-2, ex. « fra+eng ») : l'image backend n'installe
# que `fra`, toute autre langue demande un paquet système supplémentaire.
OCR_TESSERACT_LANG=fra
OCR_RENDER_DPI=200
OCR_CONFIDENCE_THRESHOLD=0.6
# Garde-fous du pipeline : pages traitées par document, et délai au-delà
# duquel un traitement est abandonné.
OCR_MAX_PAGES=50
OCR_PIPELINE_TIMEOUT_SECONDS=300
TASK_QUEUE_WORKERS=2

# --- Odoo (laisser vide désactive la synchronisation) ------------------------
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
# Clé API d'un utilisateur applicatif : prime sur ODOO_PASSWORD si renseignée.
ODOO_API_KEY=
ODOO_TIMEOUT_SECONDS=30

# --- Matching ----------------------------------------------------------------
# Tolérances d'écart relatives (0.02 = 2 %) au-delà desquelles une anomalie
# est levée lors du rapprochement facture / bon de commande.
MATCHING_QUANTITY_TOLERANCE=0.05
MATCHING_PRICE_TOLERANCE=0.02
MATCHING_AMOUNT_TOLERANCE=0.02
MATCHING_TAX_TOLERANCE=0.02
# Devise de référence des taux de change mis en cache depuis Odoo.
FX_BASE_CURRENCY=EUR
